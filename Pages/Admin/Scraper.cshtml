@page
@model KinoAnalyzer.Pages.Admin.ScraperModel
@{
    ViewData["Title"] = "Administrador Scraper";
}

<h1>Administrador del Scraper</h1>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Ejecutar Scraper</h5>
        <p class="card-text">
            Descarga los sorteos históricos desde resultadoskinochile.com y los guarda en la base de datos.
        </p>

        <form method="post">
            <button type="submit" class="btn btn-primary">Ejecutar Scraper</button>
        </form>
    </div>
</div>

@if (Model.Resultado != null)
{
    <div class="alert alert-success mt-3">
        <h5>Scraper finalizado</h5>
        <p>Sorteos guardados: <strong>@Model.Resultado.Guardados</strong></p>
        <p>Sorteos saltados: <strong>@Model.Resultado.Saltados</strong></p>
    </div>
}

@if (Model.Error != null)
{
    <div class="alert alert-danger mt-3">
        <p>Error: @Model.Error</p>
    </div>
}